{
  "id": "dk.fredskilde.dantherm",
  "version": "1.0.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Dantherm HCV",
    "da": "Dantherm HCV"
  },
  "description": {
    "en": "Fresh air on autopilot — temperatures, humidity, bypass and fan levels in every Flow",
    "da": "Frisk luft på autopilot — temperaturer, fugt, bypass og ventilationstrin i alle dine Flows"
  },
  "tags": {
    "en": [
      "ventilation",
      "HRV",
      "MVHR",
      "heat recovery",
      "air quality",
      "Dantherm",
      "HCV",
      "HCV400",
      "HCC",
      "RCV",
      "bypass",
      "filter",
      "Modbus"
    ],
    "da": [
      "ventilation",
      "varmegenvinding",
      "ventilationsanlæg",
      "indeklima",
      "Dantherm",
      "HCV",
      "HCV400",
      "HCC",
      "RCV",
      "bypass",
      "filter",
      "genvinding"
    ]
  },
  "category": [
    "climate"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Mike Fredskilde",
    "email": "mike.fredskilde@gmail.com"
  },
  "contributors": {
    "developers": [
      {
        "name": "Mike Fredskilde"
      }
    ]
  },
  "support": "mailto:mike.fredskilde@gmail.com",
  "source": "https://github.com/barsted-colab/homey-dantherm-hcv",
  "bugs": {
    "url": "https://github.com/barsted-colab/homey-dantherm-hcv/issues"
  },
  "brandColor": "#0091D4",
  "capabilities": {
    "dantherm_mode": {
      "type": "enum",
      "title": {
        "en": "Operating mode",
        "da": "Driftstilstand"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "icon": "/assets/mode.svg",
      "values": [
        {
          "id": "standby",
          "title": {
            "en": "Standby",
            "da": "Standby"
          }
        },
        {
          "id": "automatic",
          "title": {
            "en": "Automatic",
            "da": "Automatisk"
          }
        },
        {
          "id": "manual",
          "title": {
            "en": "Manual",
            "da": "Manuel"
          }
        },
        {
          "id": "week_program",
          "title": {
            "en": "Week program",
            "da": "Ugeprogram"
          }
        },
        {
          "id": "away",
          "title": {
            "en": "Away",
            "da": "Ferie"
          }
        },
        {
          "id": "summer",
          "title": {
            "en": "Summer",
            "da": "Sommer"
          }
        },
        {
          "id": "fireplace",
          "title": {
            "en": "Fireplace",
            "da": "Pejs"
          }
        },
        {
          "id": "night",
          "title": {
            "en": "Night",
            "da": "Natsænkning"
          }
        }
      ]
    },
    "dantherm_fan_level": {
      "type": "enum",
      "title": {
        "en": "Fan level",
        "da": "Ventilationstrin"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "icon": "/assets/fan.svg",
      "values": [
        {
          "id": "0",
          "title": {
            "en": "Off",
            "da": "Slukket"
          }
        },
        {
          "id": "1",
          "title": {
            "en": "Level 1",
            "da": "Trin 1"
          }
        },
        {
          "id": "2",
          "title": {
            "en": "Level 2",
            "da": "Trin 2"
          }
        },
        {
          "id": "3",
          "title": {
            "en": "Level 3",
            "da": "Trin 3"
          }
        },
        {
          "id": "4",
          "title": {
            "en": "Level 4",
            "da": "Trin 4"
          }
        }
      ]
    },
    "dantherm_bypass": {
      "type": "enum",
      "title": {
        "en": "Bypass damper",
        "da": "Bypass-spjæld"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/bypass.svg",
      "values": [
        {
          "id": "closed",
          "title": {
            "en": "Closed",
            "da": "Lukket"
          }
        },
        {
          "id": "in_progress",
          "title": {
            "en": "In progress",
            "da": "I gang"
          }
        },
        {
          "id": "closing",
          "title": {
            "en": "Closing",
            "da": "Lukker"
          }
        },
        {
          "id": "opening",
          "title": {
            "en": "Opening",
            "da": "Åbner"
          }
        },
        {
          "id": "opened",
          "title": {
            "en": "Open",
            "da": "Åben"
          }
        },
        {
          "id": "unknown",
          "title": {
            "en": "Unknown",
            "da": "Ukendt"
          }
        }
      ]
    },
    "measure_filter_remain": {
      "type": "number",
      "title": {
        "en": "Filter remaining",
        "da": "Filter tilbage"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "days",
        "da": "dage"
      },
      "decimals": 0,
      "uiComponent": "sensor",
      "icon": "/assets/filter.svg",
      "insights": true
    },
    "measure_rpm": {
      "type": "number",
      "title": {
        "en": "Fan speed",
        "da": "Ventilatorhastighed"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "rpm",
        "da": "o/min"
      },
      "decimals": 0,
      "uiComponent": "sensor",
      "icon": "/assets/fan.svg",
      "insights": true
    },
    "measure_airflow": {
      "type": "number",
      "title": {
        "en": "Airflow",
        "da": "Luftmængde"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "m³/h",
        "da": "m³/h"
      },
      "decimals": 0,
      "uiComponent": "sensor",
      "icon": "/assets/airflow.svg",
      "insights": true
    },
    "measure_air_quality": {
      "type": "number",
      "title": {
        "en": "Air quality",
        "da": "Luftkvalitet"
      },
      "getable": true,
      "setable": false,
      "units": {
        "en": "ppm",
        "da": "ppm"
      },
      "decimals": 0,
      "uiComponent": "sensor",
      "icon": "/assets/air.svg",
      "insights": true
    }
  },
  "drivers": [
    {
      "id": "hcv",
      "name": {
        "en": "Dantherm HCV",
        "da": "Dantherm HCV"
      },
      "class": "fan",
      "capabilities": [
        "onoff",
        "dantherm_mode",
        "dantherm_fan_level",
        "measure_temperature.outdoor",
        "measure_temperature.supply",
        "measure_temperature.extract",
        "measure_temperature.exhaust",
        "measure_temperature.room",
        "measure_humidity",
        "measure_air_quality",
        "dantherm_bypass",
        "measure_filter_remain",
        "measure_rpm.fan1",
        "measure_rpm.fan2",
        "measure_airflow.extract",
        "measure_airflow.supply",
        "measure_power",
        "alarm_generic"
      ],
      "capabilitiesOptions": {
        "measure_temperature.outdoor": {
          "title": {
            "en": "Outdoor (T1)",
            "da": "Udeluft (T1)"
          },
          "insights": true
        },
        "measure_temperature.supply": {
          "title": {
            "en": "Supply (T2)",
            "da": "Tilluft (T2)"
          },
          "insights": true
        },
        "measure_temperature.extract": {
          "title": {
            "en": "Extract (T3)",
            "da": "Fraluft (T3)"
          },
          "insights": true
        },
        "measure_temperature.exhaust": {
          "title": {
            "en": "Exhaust (T4)",
            "da": "Afkast (T4)"
          },
          "insights": true
        },
        "measure_temperature.room": {
          "title": {
            "en": "Room",
            "da": "Rum"
          },
          "insights": true
        },
        "measure_rpm.fan1": {
          "title": {
            "en": "Extract fan",
            "da": "Udsugningsventilator"
          }
        },
        "measure_rpm.fan2": {
          "title": {
            "en": "Supply fan",
            "da": "Indblæsningsventilator"
          }
        },
        "measure_airflow.extract": {
          "title": {
            "en": "Extract airflow",
            "da": "Udsugning"
          },
          "insights": true
        },
        "measure_airflow.supply": {
          "title": {
            "en": "Supply airflow",
            "da": "Indblæsning"
          },
          "insights": true
        },
        "measure_power": {
          "title": {
            "en": "Power (estimated)",
            "da": "Effekt (estimeret)"
          },
          "insights": true
        },
        "alarm_generic": {
          "title": {
            "en": "Alarm",
            "da": "Alarm"
          }
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/hcv/assets/images/small.png",
        "large": "/drivers/hcv/assets/images/large.png",
        "xlarge": "/drivers/hcv/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Connection",
            "da": "Forbindelse"
          },
          "children": [
            {
              "id": "host",
              "type": "text",
              "label": {
                "en": "IP address",
                "da": "IP-adresse"
              },
              "value": "",
              "hint": {
                "en": "The local IP address of the unit. Updated automatically if it changes.",
                "da": "Anlæggets lokale IP-adresse. Opdateres automatisk hvis den ændrer sig."
              }
            },
            {
              "id": "port",
              "type": "number",
              "label": {
                "en": "Modbus TCP port",
                "da": "Modbus TCP-port"
              },
              "value": 502,
              "min": 1,
              "max": 65535,
              "hint": {
                "en": "Default is 502.",
                "da": "Standard er 502."
              }
            },
            {
              "id": "polling_interval",
              "type": "number",
              "label": {
                "en": "Polling interval",
                "da": "Poll-interval"
              },
              "value": 30,
              "min": 10,
              "max": 300,
              "units": {
                "en": "seconds",
                "da": "sekunder"
              },
              "hint": {
                "en": "How often to read values from the unit.",
                "da": "Hvor ofte der læses værdier fra anlægget."
              }
            },
            {
              "id": "auto_rediscover",
              "type": "checkbox",
              "label": {
                "en": "Recover from IP changes",
                "da": "Genfind ved IP-skift"
              },
              "value": true,
              "hint": {
                "en": "If the unit stops responding, search the network for it by serial number and update the address.",
                "da": "Hvis anlægget ikke svarer, søges der efter det på netværket ud fra serienummeret, og adressen opdateres."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Bypass and free cooling",
            "da": "Bypass og fri køling"
          },
          "children": [
            {
              "id": "bypass_min_temp",
              "type": "number",
              "label": {
                "en": "Bypass minimum temperature",
                "da": "Bypass minimumstemperatur"
              },
              "value": 12,
              "min": 12,
              "max": 15,
              "step": 0.5,
              "units": {
                "en": "°C",
                "da": "°C"
              },
              "hint": {
                "en": "Outdoor temperature below which the bypass stays closed. Requires firmware 2.70 or newer.",
                "da": "Udetemperatur hvorunder bypass forbliver lukket. Kræver firmware 2.70 eller nyere."
              }
            },
            {
              "id": "bypass_max_temp",
              "type": "number",
              "label": {
                "en": "Bypass maximum temperature",
                "da": "Bypass maksimumstemperatur"
              },
              "value": 24,
              "min": 21,
              "max": 27,
              "step": 0.5,
              "units": {
                "en": "°C",
                "da": "°C"
              },
              "hint": {
                "en": "Room temperature above which free cooling opens the bypass. Requires firmware 2.70 or newer.",
                "da": "Rumtemperatur hvorover fri køling åbner bypass. Kræver firmware 2.70 eller nyere."
              }
            },
            {
              "id": "bypass_min_temp_summer",
              "type": "number",
              "label": {
                "en": "Summer bypass minimum",
                "da": "Sommer bypass minimum"
              },
              "value": 12,
              "min": 12,
              "max": 17,
              "step": 0.5,
              "units": {
                "en": "°C",
                "da": "°C"
              },
              "hint": {
                "en": "Only used in summer mode. Requires firmware 3.08 or newer.",
                "da": "Bruges kun i sommerdrift. Kræver firmware 3.08 eller nyere."
              }
            },
            {
              "id": "bypass_max_temp_summer",
              "type": "number",
              "label": {
                "en": "Summer bypass maximum",
                "da": "Sommer bypass maksimum"
              },
              "value": 24,
              "min": 21,
              "max": 30,
              "step": 0.5,
              "units": {
                "en": "°C",
                "da": "°C"
              },
              "hint": {
                "en": "Only used in summer mode. Requires firmware 3.08 or newer.",
                "da": "Bruges kun i sommerdrift. Kræver firmware 3.08 eller nyere."
              }
            },
            {
              "id": "manual_bypass_duration",
              "type": "number",
              "label": {
                "en": "Manual bypass duration",
                "da": "Manuel bypass varighed"
              },
              "value": 180,
              "min": 60,
              "max": 480,
              "step": 15,
              "units": {
                "en": "minutes",
                "da": "minutter"
              },
              "hint": {
                "en": "How long manual bypass stays selected before the unit reverts.",
                "da": "Hvor længe manuel bypass forbliver valgt, før anlægget skifter tilbage."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Humidity and filter",
            "da": "Fugt og filter"
          },
          "children": [
            {
              "id": "humidity_setpoint",
              "type": "number",
              "label": {
                "en": "Humidity setpoint",
                "da": "Fugtighedssætpunkt"
              },
              "value": 45,
              "min": 35,
              "max": 65,
              "units": {
                "en": "%",
                "da": "%"
              },
              "hint": {
                "en": "Humidity above which the unit increases ventilation. Requires firmware 2.70 or newer.",
                "da": "Fugtighed hvorover anlægget øger ventilationen. Kræver firmware 2.70 eller nyere."
              }
            },
            {
              "id": "filter_lifetime",
              "type": "number",
              "label": {
                "en": "Filter lifetime",
                "da": "Filterlevetid"
              },
              "value": 180,
              "min": 0,
              "max": 360,
              "units": {
                "en": "days",
                "da": "dage"
              },
              "hint": {
                "en": "Days between filter changes. Reset the timer from a Flow after replacing the filter.",
                "da": "Dage mellem filterskift. Nulstil timeren fra et Flow når filteret er skiftet."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Airflow and power (estimated)",
            "da": "Luftmængde og effekt (estimeret)"
          },
          "children": [
            {
              "id": "airflow_enabled",
              "type": "checkbox",
              "label": {
                "en": "Estimate airflow and power",
                "da": "Estimér luftmængde og effekt"
              },
              "value": false,
              "hint": {
                "en": "The unit measures fan speed, not volume. With the figures from your commissioning report the app can scale speed into m³/h. Leave off if you do not have the report — a guessed number is worse than none.",
                "da": "Anlægget måler omdrejninger, ikke volumen. Med tallene fra din indreguleringsrapport kan appen omregne omdrejninger til m³/h. Lad den være slået fra hvis du ikke har rapporten — et gættet tal er værre end intet."
              }
            },
            {
              "id": "airflow_nominal_level",
              "type": "number",
              "label": {
                "en": "Level the unit was commissioned at",
                "da": "Trin anlægget er indreguleret på"
              },
              "value": 3,
              "min": 1,
              "max": 4,
              "hint": {
                "en": "Dantherm calibrates at level 3, the nominal setting.",
                "da": "Dantherm indregulerer på trin 3, den nominelle indstilling."
              }
            },
            {
              "id": "airflow_extract_nominal",
              "type": "number",
              "label": {
                "en": "Extract at that level",
                "da": "Udsugning ved det trin"
              },
              "value": 216,
              "min": 0,
              "max": 1000,
              "units": {
                "en": "m³/h",
                "da": "m³/h"
              }
            },
            {
              "id": "airflow_supply_nominal",
              "type": "number",
              "label": {
                "en": "Supply at that level",
                "da": "Indblæsning ved det trin"
              },
              "value": 201,
              "min": 0,
              "max": 1000,
              "units": {
                "en": "m³/h",
                "da": "m³/h"
              }
            },
            {
              "id": "power_nominal",
              "type": "number",
              "label": {
                "en": "Power at that level",
                "da": "Effektforbrug ved det trin"
              },
              "value": 40,
              "min": 0,
              "max": 3000,
              "units": {
                "en": "W",
                "da": "W"
              }
            },
            {
              "id": "power_idle",
              "type": "number",
              "label": {
                "en": "Standing power",
                "da": "Grundforbrug"
              },
              "value": 15,
              "min": 0,
              "max": 500,
              "units": {
                "en": "W",
                "da": "W"
              },
              "hint": {
                "en": "What the electronics draw regardless of fan speed. Fan power itself follows the cube of speed on top of this.",
                "da": "Hvad elektronikken trækker uanset ventilatorhastighed. Selve ventilatoreffekten følger hastigheden i tredje potens oven i dette."
              }
            },
            {
              "id": "airflow_rpm_extract_ref",
              "type": "number",
              "label": {
                "en": "Reference extract speed",
                "da": "Reference-omdrejninger udsugning"
              },
              "value": 0,
              "min": 0,
              "max": 6000,
              "units": {
                "en": "rpm",
                "da": "o/min"
              },
              "hint": {
                "en": "Captured automatically the first time the unit is seen running at the commissioned level. Set to 0 to capture again after a filter change or re-balancing.",
                "da": "Registreres automatisk første gang anlægget ses køre på det indregulerede trin. Sæt til 0 for at registrere igen efter filterskift eller ny indregulering."
              }
            },
            {
              "id": "airflow_rpm_supply_ref",
              "type": "number",
              "label": {
                "en": "Reference supply speed",
                "da": "Reference-omdrejninger indblæsning"
              },
              "value": 0,
              "min": 0,
              "max": 6000,
              "units": {
                "en": "rpm",
                "da": "o/min"
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Night mode",
            "da": "Natsænkning"
          },
          "children": [
            {
              "id": "night_mode_start_hour",
              "type": "number",
              "label": {
                "en": "Start hour",
                "da": "Starttime"
              },
              "value": 22,
              "min": 0,
              "max": 23
            },
            {
              "id": "night_mode_start_minute",
              "type": "number",
              "label": {
                "en": "Start minute",
                "da": "Startminut"
              },
              "value": 0,
              "min": 0,
              "max": 59
            },
            {
              "id": "night_mode_end_hour",
              "type": "number",
              "label": {
                "en": "End hour",
                "da": "Sluttime"
              },
              "value": 6,
              "min": 0,
              "max": 23
            },
            {
              "id": "night_mode_end_minute",
              "type": "number",
              "label": {
                "en": "End minute",
                "da": "Slutminut"
              },
              "value": 0,
              "min": 0,
              "max": 59
            }
          ]
        }
      ]
    }
  ],
  "widgets": {
    "status": {
      "id": "status",
      "name": {
        "en": "Ventilation status",
        "da": "Ventilationsstatus"
      },
      "height": 424,
      "transparent": false,
      "devices": {
        "type": "app",
        "singular": true,
        "filter": {
          "driver_id": "hcv"
        }
      },
      "settings": [
        {
          "id": "show_efficiency",
          "type": "checkbox",
          "title": {
            "en": "Show heat recovery efficiency",
            "da": "Vis genvindingsgrad"
          },
          "value": true,
          "hint": {
            "en": "Calculated from the supply, extract and outdoor temperatures. Not shown while the bypass is open, since the exchanger is bypassed then.",
            "da": "Beregnes ud fra tilluft, fraluft og udeluft. Vises ikke mens bypass er åben, da veksleren er koblet fra."
          }
        },
        {
          "id": "allow_control",
          "type": "checkbox",
          "title": {
            "en": "Allow changing the fan level",
            "da": "Tillad ændring af ventilationstrin"
          },
          "value": true
        },
        {
          "id": "refresh_seconds",
          "type": "number",
          "title": {
            "en": "Refresh interval",
            "da": "Opdateringsinterval"
          },
          "value": 15,
          "min": 5,
          "max": 120,
          "units": {
            "en": "seconds",
            "da": "sekunder"
          }
